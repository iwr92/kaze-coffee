# La landing ya no tiene interruptor de ventas: los botones van siempre a la tienda
# WooCommerce (tienda.kazecoffee.shop) y el precio y el stock se leen de su API.

# KAZE EN CASA (bebidas preparadas). Sin valor, el canal se muestra "en preparación".
# URL https de la tienda en PedidosYa (pedidosya.com o pedidosya.com.ar).
NEXT_PUBLIC_KAZE_PEDIDOSYA_URL=
# Número de WhatsApp en formato internacional, solo dígitos (ej.: 5491122334455).
NEXT_PUBLIC_KAZE_WHATSAPP_NUMBER=
# Nota breve de zona de entrega. Solo si está confirmada.
NEXT_PUBLIC_KAZE_DELIVERY_NOTE=
